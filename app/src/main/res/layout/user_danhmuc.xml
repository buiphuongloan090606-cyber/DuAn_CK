<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/img_1"
    android:padding="30dp"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:layout_width="53dp"
            android:id="@+id/btn_userQuayLai"
            android:layout_height="wrap_content"
            android:backgroundTint="#ffffff"
            android:background="@drawable/outline_arrow_back_ios_24"
            android:textColor="#000000" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Danh mục"
            android:textSize="35dp"
            android:textStyle="bold"

            />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Khám phá ngay danh mục yêu thích "
        android:layout_marginTop="10dp"/>
    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tìm kiếm danh mục ..."
        android:background="@drawable/botron"
        android:layout_marginTop="20dp"
        android:padding="10dp"
        android:textSize="15dp"/>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D8CAD1"
        android:padding="10dp"
        android:text="Nhãn hàng"
        android:textSize="18dp"
        android:layout_marginTop="25dp"
        android:textStyle="bold"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NIKE"
            android:backgroundTint="#ffffff"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:textColor="#000000"/>
        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PUMA"
            android:backgroundTint="#ffffff"
            android:layout_marginTop="5dp"
            android:textColor="#000000"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ADIDAS"
            android:backgroundTint="#ffffff"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:textColor="#000000"/>
        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MLB"
            android:backgroundTint="#ffffff"
            android:layout_marginTop="5dp"
            android:textColor="#000000"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D8CAD1"
        android:padding="10dp"
        android:text="Giày nam"
        android:textSize="18dp"
        android:layout_marginTop="25dp"
        android:textStyle="bold"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Giày thể thao"
            android:backgroundTint="#ffffff"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:textColor="#000000"/>
        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Giày sneaker"
            android:backgroundTint="#ffffff"
            android:layout_marginTop="5dp"
            android:textColor="#000000"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Giày da"
            android:backgroundTint="#ffffff"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:textColor="#000000"/>
        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Giày công sở"
            android:backgroundTint="#ffffff"
            android:layout_marginTop="5dp"
            android:textColor="#000000"/>
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D8CAD1"
        android:padding="10dp"
        android:text="Giày nam"
        android:textSize="18dp"
        android:layout_marginTop="25dp"
        android:textStyle="bold"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Giày thể thao"
            android:backgroundTint="#ffffff"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:textColor="#000000"/>
        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Giày sneaker"
            android:backgroundTint="#ffffff"
            android:layout_marginTop="5dp"
            android:textColor="#000000"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Giày da"
            android:backgroundTint="#ffffff"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:textColor="#000000"/>
        <Button
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Giày công sở"
            android:backgroundTint="#ffffff"
            android:layout_marginTop="5dp"
            android:textColor="#000000"/>
    </LinearLayout>

</LinearLayout>